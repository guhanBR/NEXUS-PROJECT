# ==============================================================================
# RebalanceX — Comprehensive .gitignore
# ==============================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
pythonenv/

# --- Environment & Secret Keys ---
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.secret
secrets/

# --- SQLite & Local Databases ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/rebalancex.db

# --- Unit Tests & Coverage ---
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
htmlcov/

# --- Node / Frontend (if npm used) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak
yarn.lock.bak
.npm

# --- IDEs & Editors ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.bak

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Logs & Runtime Artifacts ---
*.log
logs/
*.pid
*.seed
*.pid.lock
tmp/
temp/
scratch/

# --- AI & Agent Workspaces ---
.agents/
.agent/
.gemini/

