# ==============================================================================
# RebalanceX — Environment Variables Template
# Copy this file to .env and configure your MongoDB Atlas credentials.
# ==============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# MongoDB Atlas Configuration
# Note: If MONGODB_URI is empty or unconfigured, RebalanceX uses local memory/file persistence fallback safely.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/rebalancex?retryWrites=true&w=majority
DATABASE_NAME=rebalancex
MONGODB_TIMEOUT_MS=5000

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
